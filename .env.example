# Copy this file to .env and fill in the values
# cp .env.example .env

# PostgreSQL connection string
# Matches the docker-compose.yml defaults
DATABASE_URL=postgresql+psycopg2://recall:recall@localhost:5432/recall

# OpenAI API key — required for embeddings and answer generation
OPENAI_API_KEY=sk-...

# Embedding model (default: text-embedding-3-small, 1536-dim)
EMBEDDING_MODEL=text-embedding-3-small

# Answer generation model
ANSWER_MODEL=gpt-4.1-mini
